  "semantics": {
    "recursion": "single self-recursive integer column; source-free seed; positive integer step; monotone guarded recursion",
    "evaluation": "seed once, then delta for each previous iteration; SQL UNION ALL preserves occurrences, UNION DISTINCT deduplicates",
    "safety": "portable signed 32-bit arithmetic only, including every generated step; source-free monotone positive induction, at most 10000 materialized occurrences; cyclic/unknown and unsupported/overlarge cases remain Residual",
    "truth": "exact non-NULL produced values; terminal negative membership and NULL requests are Impossible only against the complete final bag; SQL predicate comparisons with NULL evaluate UNKNOWN",
    "provenance": "one recursive producer explicitly self-references its prior-iteration bag and terminal references the producer; per-occurrence IDs are stable and not independent physical inserts"
  },
