  "scope": "Authoritative metadata fact ownership and absence laws for direct SQL DDL, dbt manifest compiled SQL/dependencies/declared constraints, dbt catalog-introspected datatypes, dbt manifest declaration fallback, and ODCS physical/logical types. Materializations are TASK-174 and qualified identities/FK-only schemas are TASK-175.",
  "authority_priority": [
    {
      "fact": "model_sql",
      "owner": "dbt_manifest.nodes.compiled_code",
      "fallback": "raw_code only when non-Jinja and explicitly known",
      "must_not_infer": "dbt catalog columns or materialization"
    },
    {
      "fact": "model_dependencies",
      "owner": "dbt_manifest.nodes.depends_on.nodes",
      "fallback": "none",
      "must_not_infer": "catalog resource list"
    },
    {
      "fact": "constraints_and_tests",
      "owner": "dbt_manifest declared constraints and built-in tests",
      "fallback": "none",
      "must_not_infer": "physical enforcement from a passing test definition"
    },
    {
      "fact": "warehouse_datatype",
      "owner": "dbt_catalog.columns.type",
      "fallback": "complete dbt manifest columns.data_type as declared (not introspected) evidence",
      "must_not_infer": "type from SQL literals or missing metadata"
    },
    {
      "fact": "external_contract",
      "owner": "ODCS physicalType when valid",
      "fallback": "recognized logicalType with lower-authority diagnostic",
      "must_not_infer": "unsupported logicalType over valid physicalType"
    },
    {
      "fact": "direct_ddl",
      "owner": "parsed CREATE TABLE column definitions",
      "fallback": "none",
      "must_not_infer": "executed runtime state without a physical oracle"
    }
  ],
