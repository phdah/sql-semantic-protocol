      "true_proof": "filtered k>1 then complete same-key join produces exactly two source-derived pairs",
      "not_true_proof": "raw k=1 is FALSE and cannot be inserted as a producer row",
      "expected_physical": "Exact",
      "native_oracle": "DuckDB physical and complete terminal bag"
