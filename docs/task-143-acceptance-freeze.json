      "id": "78-C143-P-JOIN",
      "fixture_family": "78-C143-P",
      "variant": "filtered computed producer reused by two JOIN consumers",
      "classification": "mandatory_exact",
      "sql": "WITH stage AS (SELECT k, k + 10 AS shifted FROM raw WHERE k > 1) SELECT a.shifted AS l, b.shifted AS r FROM stage a JOIN stage b ON a.k = b.k ORDER BY l, r",
      "initial_bags": {
        "raw": [
          {
            "id": "raw#0",
            "k": 1
          },
          {
            "id": "raw#1",
            "k": 2
          },
          {
            "id": "raw#2",
            "k": 3
          }
        ]
      },
      "producer_bags": {
        "stage": [
          {
            "source_ids": [
              "raw#1"
            ],
            "k": 2,
            "shifted": 12
          },
          {
            "source_ids": [
              "raw#2"
            ],
            "k": 3,
            "shifted": 13
          }
        ]
      },
      "terminal_bag": [
        {
          "source_ids": [
            "raw#1",
            "raw#1"
          ],
          "l": 12,
          "r": 12
        },
        {
          "source_ids": [
            "raw#2",
            "raw#2"
          ],
          "l": 13,
          "r": 13
        }
      ],
      "terminal_domains": {
