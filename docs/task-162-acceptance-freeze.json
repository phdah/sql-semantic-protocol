    "odcs": "Schema and constraint evidence only, no inferred transaction execution"
  },
  "cases": [
    {
      "id": "84-C162-P-rollback",
      "family": "BEGIN_ROLLBACK",
      "classification": "exact_required",
      "sql": [
        "CREATE TABLE t (id INTEGER, v INTEGER)",
        "BEGIN",
        "INSERT INTO t (id, v) VALUES (1, 10), (2, NULL), (2, NULL)",
        "ROLLBACK"
      ],
      "expected": {
        "final": [],
        "affected_inserted": 3,
        "rollback_restores_original_bag": true,
        "typed_domains": {
          "id": {
            "empty": true
          },
          "v": {
            "empty": true
          }
        },
        "negative_direction": "Both positive and SQL NULL inserted occurrences absent after ROLLBACK"
      },
      "dialect": "duckdb",
      "native_oracle": "Full source/checkpoint/final snapshots per statement"
    },
    {
      "id": "84-C162-P-commit",
      "family": "BEGIN_COMMIT",
      "classification": "exact_required",
      "sql": [
        "CREATE TABLE t (id INTEGER, v INTEGER)",
        "BEGIN",
        "INSERT INTO t (id, v) VALUES (2, 20), (3, NULL)",
        "COMMIT",
        "SELECT id, v FROM t WHERE v >= 20"
      ],
      "expected": {
        "final": [
          {
            "id": 2,
            "v": 20
          },
          {
            "id": 3,
            "v": null
          }
        ],
        "affected_inserted": 2,
        "selected": [
          {
            "id": 2,
            "v": 20
          }
        ],
        "not_true_source_ordinals": [
          1
        ],
        "typed_domains": {
          "id": {
            "lower": 2,
            "upper": 3,
            "inclusive": true
          },
          "v": {
            "values": [
              20,
              null
            ]
          }
        }
      },
      "dialect": "duckdb",
      "native_oracle": "Full source/checkpoint/read/final snapshots"
    },
    {
